# libFuzzer dictionary for redact_secret_lines_fuzzer (config_write.redact_secret_lines).
# Every branch this harness cares about is gated on a literal: the `${`/`}` interpolation
# delimiters, the `://` + `@` that make a URL credential-bearing, the `:`/`=` that make a
# line key-value shaped, and the secret-key vocabulary. Atheris' FuzzedDataProvider does
# not synthesise any of them from random bytes, so without this dict (and the seed corpus)
# the harness only ever exercises the nothing-to-mask path. See fuzz/README.md.

# interpolation
"${"
"}"
"${}"
"${A}"
"${GITHUB_TOKEN}"
"${b${c}"

# credential-bearing URL
"://"
"@"
"https://u@h"
"slack+v2://xoxb-0@host"
"-http://u@h"
# non-ASCII scheme letters that case-fold into [a-z] (U+212A KELVIN, U+017F LONG S)
"\xe2\x84\xaa://u@h"
"\xc5\xbf://u@h"

# key: value line shape
":"
"="
": "
" = "
".-"

# the secret-key vocabulary (_SECRET_KEY_RE)
"token"
"secret"
"password"
"passwd"
"api_key"
"api-key"
"apikey"
"auth"
"authn"
"authorization"
"AUTH_TOKEN"
"credential"
"bearer"
# the negative-lookahead exclusions, so the fuzzer can straddle the author/authn boundary
"author"
"authors"

# line-ending shapes the contract must preserve exactly
"\x0d\x0a"
"\x0a"
"\x0d"
"\x0b"
"\x0c"
"\xc2\x85"

# the sentinel itself, so the second-pass differential gets fed already-redacted text
"********"
