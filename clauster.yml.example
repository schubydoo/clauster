# Clauster configuration — copy to clauster.yml and edit.
#
# Search order:  $CLAUSTER_CONFIG -> ./clauster.yml -> $CLAUSTER_HOME/clauster.yml
# Any scalar key is env-overridable: CLAUSTER_<UPPER_SNAKE_PATH> (e.g. CLAUSTER_PORT=8080).
# Schema is additive-only — old configs keep working in newer versions.
# Every key + its full semantics: docs/configuration.md. Uncommented values below are the
# defaults; commented-out keys are optional (shown at a default or an example value).

schema_version: 1
projects_root: ~/code        # required — dir whose subfolders are your projects (must exist, be readable)
host: 127.0.0.1              # a non-loopback bind requires enforced auth (see auth:)
port: 7621
state_dir: ~/.clauster       # DB, logs, pid/socket files
root_path: ""                # URL subpath when behind a reverse proxy
log_format: text             # text | json
# instance_name: prod        # label; retitles the process to clauster[<name>] (<=32 chars [A-Za-z0-9_.-])

claude:
  binary: claude             # name on PATH or absolute path
  min_version: "2.1.145"
  agents_json_poll_interval_seconds: 30   # liveness/crash-detection poll cadence
  startup_grace_seconds: 60  # a bridge alive-but-unregistered past this -> ERROR
  auto_enable_remote_control: true        # pre-ack remote control so a detached bridge skips the prompt
  resume_recap: false        # opt-in SessionStart hook: recap the prior transcript into a restarted bridge
  resume_recap_max_chars: 8000
  launch_mode: standard      # standard (headless Server Mode) | pty (Interactive Session, true resume, POSIX).
                             # Default for NEW bridges only; the per-launch Mode picker overrides it.
  # path_append: ["~/.local/bin"]   # dirs appended to the bridge PATH (~ expanded; appended, never replacing)
  # node_from_nvm: true      # default-on (#859): append nvm `default` node's bin dir to the bridge PATH
  #                          # (fixes npx/node MCP under systemd). Set false to skip it.
  # env: {FOO: bar}          # extra bridge env, applied after the secret scrub

instance_defaults:
  spawn_mode: same-dir       # same-dir | worktree (git repos) | session
  permission_mode: default   # default | plan | acceptEdits | auto | dontAsk | bypassPermissions
  capacity: 32               # max sessions within one bridge (claude --capacity)
  # session_name_prefix: myteam    # prefix for auto-generated session names (default: hostname)
  # max_bridges: 8           # best-effort cap on remote-control bridges (unset = no limit)

# Per-project overrides. allow_bypass_permissions is the hard ceiling for the
# bypassPermissions footgun — not selectable in the UI unless set true here.
projects: {}
#   my-project:
#     allow_bypass_permissions: false

auth:
  enabled: false             # MASTER switch — required for password_required / reverse_proxy to be enforced
  password_required: false
  password_hash: null        # argon2id; generate via `clauster hash-password`
  # api_token_hash: null     # SHA-256 (from `clauster hash-token`) enabling `Authorization: Bearer <token>`;
  #                          # satisfies enforced-auth for a non-loopback bind. Store only the hash.
  cookie_secure: auto        # auto | always | never
  session_max_age_seconds: 604800   # 7 days
  allowed_origins: []        # extra WS/CSRF origins (e.g. your proxy domain)
  allow_unauthenticated_network: false
  reverse_proxy:
    enabled: false
    user_header: "Remote-User"
    shared_secret_header: "X-Proxy-Auth"
    shared_secret: null      # HMAC key the proxy signs the auth header with
    trusted_ips: []
    hmac_window_seconds: 60
    # require_hmac: true      # set false for header-only forward-auth proxies (Authelia/Traefik/oauth2-proxy)

# Versioned /api/v1 public surface (docs/public-api.md). The internal /api/... routes are always present.
api:
  openapi_enabled: false      # serve /docs + /openapi.json (Bearer-gated when auth.enabled)

# Web-dashboard kill switch (#806, restart required; NOT editable in-app). false = serve ONLY the
# JSON API (dashboard page, /login, /static/*, HTML fragments 404). See docs/public-api.md#api-only-deployment.
# ui:
#   enabled: true

# Native HTTPS — Clauster terminates TLS itself (structural; file/CLI-managed only). Unset = plain HTTP.
# Paths are validated fail-closed at load + start (a missing file aborts startup, never falls back to HTTP).
# Full detail incl. self-signed provisioning: docs/configuration.md. (ACME / Let's Encrypt: issue #774.)
# tls:
#   cert_file: /etc/clauster/tls/fullchain.pem   # PEM cert chain (or use provision: self-signed)
#   key_file: /etc/clauster/tls/privkey.pem
#   # provision: self-signed  # generate an RSA-2048 cert+key under state_dir/tls/; needs `cryptography`
#   # hostnames: [192.168.1.10, clauster.local]  # first = CN, rest = SANs

# Pre-migration SQLite snapshot (VACUUM INTO state_dir/backups/, keeps last 5). On by default.
# db:
#   backup_before_migrate: true

logs:
  bridge_log_max_size_mb: 10
  keep_rotated: 5
  redact_session_url: false  # false = verbatim on disk, redacted over WS
  strip_ansi_in_stream: true
  # retention_max_age_days: 30   # drop a spawn's log set once its newest file is older than this (0 = forever)
  # retention_max_files: 0       # keep only the N most recent log sets (0 = unlimited)
  # retention_max_total_mb: 0    # cap the bridge-logs dir size in MB (0 = unlimited)

# Project create/clone guards (clone URLs are user-supplied + hit the network).
clone:
  enabled: true
  allowed_schemes: [https, ssh]
  allow_private_hosts: false  # block private/LAN IPs by default (SSRF)
  allowed_private_cidrs: []   # targeted LAN opt-in, e.g. ["192.168.1.0/24"]
  timeout_seconds: 300
  max_mb: 2048                # post-clone size cap; 0 = unlimited

# Ghost-environment reaper: the CLI (`clauster reap-environments`) is always available;
# this only gates the destructive browser button.
reaper:
  ui_enabled: false

# Per-project cost/token badge. cost is an APPROXIMATE estimate (transcript tokens x a
# hand-maintained USD table); mode: off hides it (and skips the usage fetch).
usage:
  mode: cost                  # cost | tokens | off
  # currency: USD
  # currency_symbol: null     # cost-mode prefix; defaults to $ for USD
  # fx_rate: 1.0              # STATIC multiplier on the USD figure (no live FX)
  # token_total_includes_cache: true

# Live per-bridge resource metrics (CPU / memory / disk) on a running card. On by default.
# metrics:
#   enabled: true
#   normalize_cpu: false      # divide CPU% by host cores
#   show_disk: true
#   sample_interval_seconds: 0.15   # two-snapshot window (<=2.0)
#   poll_seconds: 4.0         # dashboard refresh cadence

# Read-only Prometheus /metrics. Off by default; stays behind the auth guard unless a token hash is set.
# observability:
#   prometheus_enabled: false
#   metrics_token_hash: null  # SHA-256 (from `clauster hash-metrics-token`) for token-only scrape access

# Outbound bridge-lifecycle notifications via Apprise (extra: pip install 'clauster[notify]').
# Best-effort + fail-closed — a notify failure never affects the bridge lifecycle.
# notifications:
#   enabled: false            # MASTER switch for the Apprise channel
#   urls: []                  # e.g. ["discord://...", "tgram://..."]
#   browser_enabled: false    # in-browser Web Notifications (no URL needed)
#   notify_on_crash: true
#   notify_on_ready: false
#   notify_on_stop: false
#   notify_on_permission: false
#   notify_on_session_end: false
#   notify_on_reconnect_failed: false

# Outbound HTTP webhooks on lifecycle transitions. Fail-open (timeout-bounded); http/https only.
# webhooks:
#   enabled: false
#   urls: []                  # e.g. ["https://example.com/hooks/clauster"]
#   timeout_seconds: 10.0
#   block_private_targets: false   # opt-in SSRF guard for IP-literal targets (default keeps LAN receivers)
#   events:
#     spawn: true             # bridge events (absent = ENABLED, the historical default)
#     ready: true
#     stop: true
#     crash: true
#     bg-settled: false       # extended events (absent = DISABLED — opt in explicitly)
#     permission-needed: false
#     clone-done: false

# Claustrum Direct Session live-view channel (EXPERIMENTAL). Connect-or-spawns one claustrum
# daemon per deployment; hosts headless stream-json sessions with a live dashboard panel.
# Fail-closed (surfaces in /healthz, never touches bridges). LOCAL live-view only — Direct
# Sessions are NOT attachable from claude.ai/code or the mobile app.
# claustrum:
#   enabled: false
#   binary: claustrum         # name on PATH or absolute path
#   socket_path: null         # default: <state_dir>/claustrum/daemon.sock
#   spawn_timeout_seconds: 10.0
#   keep_children: true       # daemon restart leaves hosted sessions running (reattach on reconnect; POSIX)
#   request_timeout_seconds: 30.0
