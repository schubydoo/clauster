# Clauster configuration — copy to clauster.yml and edit.
#
# Search order:  $CLAUSTER_CONFIG -> ./clauster.yml -> $CLAUSTER_HOME/clauster.yml
# Any scalar or list key is env-overridable: CLAUSTER_<UPPER_SNAKE_PATH> (e.g.
# CLAUSTER_PORT=8080; lists are comma-separated, e.g.
# CLAUSTER_AUTH_ALLOWED_ORIGINS=https://a.example,https://b.example).
# Schema is additive-only — old configs keep working in newer versions.
#
# This is a LEAN STARTER. The uncommented keys are what most deployments actually set; every
# other section is still shown (commented, at its default) so you can see it exists without the
# noise. The FULL per-key reference — every option, type, and default — lives in
# docs/reference/config.md, so this file points there by section instead of repeating it.

schema_version: 1
projects_root: ~/code        # required — dir whose subfolders are your projects (must exist, be readable)
host: 127.0.0.1              # a non-loopback bind REQUIRES enforced auth (see auth:)
port: 7621
state_dir: ~/.clauster       # DB, logs, pid/socket files
log_format: text             # text | json
# root_path: ""              # URL subpath when behind a reverse proxy
# instance_name: prod        # process label -> clauster[<name>] (<=32 chars [A-Za-z0-9_.-])

claude:
  binary: claude             # name on PATH or absolute path
  launch_mode: standard      # standard (headless Server Mode) | pty (Interactive Session, true resume)
  # Tuning knobs — sensible defaults; the full list is in docs/reference/config.md (claude section):
  # min_version: "2.1.145"
  # agents_json_poll_interval_seconds: 30    # liveness/crash-detection poll cadence
  # startup_grace_seconds: 60                # a bridge alive-but-unregistered past this -> ERROR
  # auto_enable_remote_control: true         # pre-ack remote control so a detached bridge skips the prompt
  # resume_recap: false                      # SessionStart hook: recap the prior transcript into a restart
  # path_append: ["~/.local/bin"]            # dirs appended to the bridge PATH (~ expanded)
  # node_from_nvm: true                      # append nvm `default` node's bin dir to the bridge PATH (#859)
  # env: {FOO: bar}                          # extra bridge env, applied after the secret scrub

instance_defaults:
  spawn_mode: same-dir       # same-dir | worktree (git repos) | session
  permission_mode: default   # default | plan | acceptEdits | auto | dontAsk | bypassPermissions
  capacity: 32               # max sessions within one bridge (claude --capacity)
  # session_name_prefix: myteam   # prefix for auto-generated session names (default: hostname)
  # max_bridges: 8           # best-effort cap on remote-control bridges (unset = no limit)

# Per-project overrides. allow_bypass_permissions is the hard ceiling for the bypassPermissions
# footgun — not selectable in the UI unless set true here.
projects: {}
#   my-project:
#     allow_bypass_permissions: false

auth:
  enabled: false             # MASTER switch — required for password_required / reverse_proxy to be enforced
  password_required: false
  password_hash: null        # argon2id; generate via `clauster hash-password`
  # api_token_hash: null     # SHA-256 (`clauster hash-token`) -> `Authorization: Bearer <token>`; satisfies
  #                          # enforced-auth for a non-loopback bind. Store only the hash.
  # Session/CSRF + reverse-proxy (Authelia/Traefik/oauth2-proxy forward-auth) options —
  # full list in docs/reference/config.md (auth / auth.reverse_proxy sections):
  # cookie_secure: auto              # auto | always | never
  # session_max_age_seconds: 604800  # 7 days
  # allowed_origins: []              # extra WS/CSRF origins (e.g. your proxy domain). The Origin
  #                                  # allowlist is enforced even when enabled=false; a loopback bind
  #                                  # auto-allows itself, a non-loopback bind MUST list its origin.
  # allow_unauthenticated_network: false
  # reverse_proxy:
  #   enabled: false
  #   user_header: "Remote-User"
  #   shared_secret: null            # HMAC key the proxy signs the auth header with

# Web-dashboard kill switch (#806, restart required; NOT editable in-app). false = serve ONLY the
# JSON API. See docs/public-api.md#api-only-deployment.
# ui:
#   enabled: true

# Versioned /api/v1 public surface (docs/public-api.md). The internal /api/... routes are always present.
# api:
#   openapi_enabled: false   # serve /docs + /openapi.json (Bearer-gated when auth.enabled)

# Config-management trust tier (#347/#687): edit Claude Code's OWN config (MCP servers, hooks,
# permission rules, skills) from the dashboard's Configuration editor. Both flags default OFF and are
# file/CLI-managed only (never web-editable — the spawned `claude` runs that config as you, so the
# browser is treated as the threat). Full detail: docs/reference/config.md (config_write section).
# config_write:
#   enabled: false
#   allow_user_scope: false        # also expose the User scope, not just Local/Project

# Dashboard-driven `claude` account login (#839): re-authenticate the runtime `claude` account from
# the browser when it's logged out / its token expired, instead of SSHing in. Defaults OFF, file/CLI-
# managed only. Full detail: docs/reference/config.md (login_shepherd section).
# login_shepherd:
#   enabled: false
#   allow_setup_token: false       # also offer setup-token mode (mints a durable token — more dangerous)

# `clauster mcp` stdio server (#527/#950): read-only by default (list_sessions / session_status). The
# stdio transport is local-privileged and unauthenticated, so the write tools (spawn/stop/resume_session)
# are gated OFF and file/CLI-managed only. Turn on to let an attached MCP client drive the bridge
# lifecycle. Full detail: docs/reference/config.md (mcp section) + docs/mcp.md.
# mcp:
#   allow_writes: false

# Native HTTPS — Clauster terminates TLS itself (structural; file/CLI-managed only). Unset = plain HTTP.
# Full detail incl. self-signed provisioning: docs/reference/config.md (tls section).
# tls:
#   cert_file: /etc/clauster/tls/fullchain.pem
#   key_file: /etc/clauster/tls/privkey.pem
#   # provision: self-signed   # generate an RSA-2048 cert+key under state_dir/tls/ (needs `cryptography`)

# Pre-migration SQLite snapshot (VACUUM INTO state_dir/backups/, keeps last 5). On by default.
# db:
#   backup_before_migrate: true

# Bridge-log rotation + redaction — defaults are fine for most (full list: docs/reference/config.md, logs section).
# logs:
#   bridge_log_max_size_mb: 10
#   keep_rotated: 5
#   redact_session_url: false      # false = verbatim on disk, redacted over WS
#   strip_ansi_in_stream: true
#   # retention_max_age_days: 30   # drop a spawn's log set once its newest file is older (0 = forever)

# Project create/clone guards (clone URLs are user-supplied + hit the network). The scalars plus
# `allowed_schemes` / `allowed_private_cidrs` are also editable from the **Advanced settings**
# panel in the dashboard's Configuration editor (behind a step-up re-auth — re-enter your login
# password). Full list: docs/reference/config.md (clone section).
clone:
  enabled: true
  # allowed_schemes: [https, ssh]
  # allow_private_hosts: false     # block private/LAN IPs by default (SSRF)
  # allowed_private_cidrs: []      # targeted LAN opt-in, e.g. ["192.168.1.0/24"]
  # timeout_seconds: 300
  # max_mb: 2048                   # post-clone size cap; 0 = unlimited

# Ghost-environment reaper: the CLI (`clauster reap-environments`) is always available; this only
# gates the destructive browser button.
# reaper:
#   ui_enabled: false

# Per-project cost/token badge (full list: docs/reference/config.md, usage section).
# usage:
#   mode: cost               # cost | tokens | off

# Live per-bridge resource metrics (CPU / memory / disk). On by default (docs/reference/config.md, metrics section).
# metrics:
#   enabled: true

# Read-only Prometheus /metrics. Off by default (docs/reference/config.md, observability section).
# observability:
#   prometheus_enabled: false

# Outbound bridge-lifecycle notifications via Apprise (extra: pip install 'clauster[notify]').
# Best-effort + fail-closed. `urls` may embed secrets, so it stays file/CLI-managed (not web-editable).
# notifications:
#   enabled: false
#   urls: []                 # e.g. ["discord://...", "tgram://..."]

# Outbound HTTP webhooks on lifecycle transitions. Fail-open (timeout-bounded); http/https only.
# The scalars + `events` are editable from the **Advanced settings** panel in the Configuration
# editor; `urls` stays file/CLI-only (may embed secrets). Full list: docs/reference/config.md (webhooks section).
# webhooks:
#   enabled: false
#   urls: []
#   events:
#     spawn: true                # bridge events (absent = ENABLED, the historical default)
#     permission-needed: false   # extended events (absent = DISABLED — opt in explicitly)

# Claustrum Direct Session live-view channel (EXPERIMENTAL). LOCAL live-view only — Direct Sessions
# are NOT attachable from claude.ai/code or the mobile app. Full detail: docs/reference/config.md (claustrum section).
# claustrum:
#   enabled: false
