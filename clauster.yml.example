# Clauster configuration — copy to clauster.yml and edit.
# Search order:  $CLAUSTER_CONFIG -> ./clauster.yml -> $CLAUSTER_HOME/clauster.yml
# Any scalar key is overridable via env: CLAUSTER_<UPPER_SNAKE_CASE_PATH>=value
#   e.g. CLAUSTER_PORT=8080  CLAUSTER_CLAUDE_BINARY=/opt/claude/bin/claude
# Schema is additive-only: old configs always work in newer versions.

schema_version: 1
projects_root: /srv/projects       # required, must exist and be readable
host: 127.0.0.1                    # non-loopback requires auth (see below)
port: 7621
state_dir: ~/.clauster             # state, logs, pid files
root_path: ""                      # subpath when behind a reverse proxy
log_format: text                   # text | json (json for Docker/Loki)
# instance_name: prod              # optional label; retitles the process to
                                   # clauster[<name>] for ps/pgrep (<=32 chars,
                                   # [A-Za-z0-9_.-]); also CLAUSTER_INSTANCE_NAME

claude:
  binary: claude                   # name on PATH or absolute path
  min_version: "2.1.145"
  agents_json_poll_interval_seconds: 300
  startup_grace_seconds: 60        # a bridge alive-but-unregistered past this -> ERROR
  auto_enable_remote_control: true # pre-ack remote control in ~/.claude.json so a
                                   # detached bridge isn't stuck on the one-time prompt
  resume_recap: false              # opt-in: install a SessionStart hook that recaps the
                                   # prior transcript into a restarted bridge's context
  resume_recap_max_chars: 8000     # recap budget (most recent turns kept)
  resume_mode: standard            # standard = headless `claude remote-control` server.
                                   # pty = run the `claude --remote-control` flag form under
                                   # a PTY keeper for true conversation resume on Restart
                                   # (single-session; POSIX only). Opt-in.
                                   # This is the DEFAULT for *new* bridges only — a bridge's
                                   # mode is fixed at launch, so editing this never changes
                                   # how an already-running or stopped bridge resumes. The
                                   # dashboard's per-launch Mode picker can override it per bridge.

instance_defaults:
  spawn_mode: same-dir             # same-dir | worktree (git repos) | session
  permission_mode: default         # default | plan | acceptEdits | auto | dontAsk | bypassPermissions
  capacity: 32                     # max sessions within one same-dir/worktree bridge (claude --capacity)
  # session_name_prefix: myteam    # prefix for auto-generated session names (default: hostname)
  # max_bridges: 8                 # best-effort cap on remote-control bridges, not hosted/bg (unset = no limit)

# Per-project overrides. allow_bypass_permissions is the hard ceiling for the
# bypassPermissions footgun — it can't be selected in the UI unless set here.
projects: {}
#   my-project:
#     allow_bypass_permissions: false

auth:
  enabled: false                   # MASTER switch — must be true for password_required /
                                   # reverse_proxy auth to actually be enforced
  password_required: false
  password_hash: null              # argon2id; generate via `clauster hash-password`
  cookie_secure: auto              # auto | always | never
  session_max_age_seconds: 604800  # 7 days
  allowed_origins: []              # extra WS/CSRF origins (e.g. your proxy domain)
  allow_unauthenticated_network: false
  reverse_proxy:
    enabled: false
    user_header: "Remote-User"
    shared_secret_header: "X-Proxy-Auth"
    shared_secret: null            # HMAC key the proxy signs the auth header with
    trusted_ips: []
    hmac_window_seconds: 60

logs:
  bridge_log_max_size_mb: 10
  keep_rotated: 5
  redact_session_url: false        # false=hybrid (verbatim on disk, redacted over WS)
  strip_ansi_in_stream: true

# Project create/clone guards (clone URLs are user-supplied + hit the network).
clone:
  enabled: true
  allowed_schemes: [https, ssh]
  allow_private_hosts: false       # block private/LAN IPs by default (SSRF)
  allowed_private_cidrs: []        # targeted LAN opt-in, e.g. ["192.168.1.0/24"]
  timeout_seconds: 300
  max_mb: 2048                     # post-clone size cap; 0 = unlimited

# Ghost-environment reaper dashboard surface. The CLI (`clauster reap-environments`)
# is always available; this only gates the destructive browser button. Off by default.
reaper:
  ui_enabled: false

# Per-project cost/token badge. The dollar figure is an APPROXIMATE estimate —
# token totals from the session transcript x a hand-maintained USD price table
# (usage.py, "as of 2026-05"); unpriced models contribute 0. mode: off hides the
# badge entirely (privacy when screen-sharing / recording a demo); the dashboard
# then also skips the per-project usage fetch. (show_cost: false is the
# deprecated alias for mode: off.)
usage:
  mode: cost                       # cost | tokens (count only) | off
  # currency: USD                  # code shown in the tooltip
  # currency_symbol: null          # cost-mode prefix; defaults to $ for USD
  # fx_rate: 1.0                   # STATIC multiplier on the USD figure (no live FX)
  # token_total_includes_cache: true  # count cache tokens in the displayed total

# Live per-bridge resource metrics (CPU / memory / disk) on a running card.
# On by default; enabled: false hides the line and skips the sampling.
# metrics:
#   enabled: true
#   normalize_cpu: false           # divide CPU% by host cores (0-100% of machine)
#   show_disk: true                # disk read/write rate portion
#   sample_interval_seconds: 0.15  # two-snapshot window (<=2.0; blocks a worker)
#   poll_seconds: 4.0              # dashboard refresh cadence

# Read-only Prometheus /metrics exposition (build info, bridge counts by status,
# project count). Off by default; when enabled it stays BEHIND the auth guard.
# observability:
#   prometheus_enabled: false

# Outbound bridge-lifecycle notifications via Apprise. Requires the optional
# extra: pip install 'clauster[notify]'. Best-effort + fail-closed — a notify
# failure never affects the bridge lifecycle.
# notifications:
#   enabled: false
#   urls: []                       # Apprise URLs, e.g. ["discord://...", "tgram://..."]
#   notify_on_crash: true          # alert when a bridge exits NOT via Stop

# Claustrum hosted live-view channel (EXPERIMENTAL). When enabled, Clauster
# connect-or-spawns one claustrum daemon per deployment and hosts headless
# stream-json sessions on it — dashboard panel with live stream, send, tool-
# permission approve/deny, resume, and orphan recovery after a daemon restart.
# Fail-closed: daemon trouble surfaces in /healthz, never touches bridges.
# NOTE: hosted sessions are LOCAL live-view only — unlike bridges, they are never
# attachable from claude.ai/code or the Claude mobile app.
# claustrum:
#   enabled: false
#   binary: claustrum              # name on PATH or absolute path
#   socket_path: null              # default: <state_dir>/claustrum/daemon.sock
#   spawn_timeout_seconds: 10.0
#   keep_children: true            # daemon restart/upgrade leaves hosted sessions
#                                  # running (reattach/recover on reconnect); POSIX only
#   request_timeout_seconds: 30.0
